{
  "openapi": "3.0.0",
  "info": {
    "version": "2.0.0",
    "title": "Bank list",
    "x-ibm-name": "bank-list",
    "description": "This API gets bank lists",
    "contact": {
      "name": "Integration APIs Team",
      "email": "Integrationsapis@stanbicibtc.com"
    }
  },
  "servers": [
    {
      "url": "https://testapi.stanbicibtc.com/test/sandbox"
    }
  ],
  "security": [
    {
      "ClientID": [],
      "ClientSecret": []
    }
  ],
  "x-ibm-configuration": {
    "type": "rest",
    "phase": "realized",
    "enforced": true,
    "testable": true,
    "application-authentication": {
      "certificate": false
    },
    "cors": {
      "enabled": true
    }
  },
  "paths": {
    "/bank-list": {
      "get": {
        "summary": "This API returns a list of different banks and their bank code",
        "parameters": [
          {
            "name": "institutionName",
            "in": "query",
            "required": false,
            "description": "institution name of the bank",
            "schema": {
              "type": "string",
              "example": "Stanbic IBTC Bank"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "page number for response payload",
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "size of the response object",
            "schema": {
              "type": "integer",
              "example": 50
            }
          },
          {
            "name": "institutionCode",
            "in": "query",
            "required": false,
            "description": "6 digit bank code",
            "schema": {
              "type": "string",
              "example": "999221"
            }
          },
          {
            "name": "v1InstitutionCode",
            "in": "query",
            "required": false,
            "description": "3 digit bank code",
            "schema": {
              "type": "string",
              "example": "221"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "category of bank",
            "schema": {
              "type": "string",
              "example": "2"
            }
          },
          {
            "name": "v1InstitutionShortName",
            "in": "query",
            "required": false,
            "description": "short name of bank",
            "schema": {
              "type": "string",
              "example": "STANBIC"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/bankListSuccessResponseBody"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/unauthorizedResponseBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/serviceUnavailableResponseBody"
                },
                "example": {
                  "responsecode": "55",
                  "responseMsg": "Service Currently Unavailable"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "bankListQueryParameters": {
        "type": "object",
        "description": "Query parameters accepted by the GET /bank-list endpoint",
        "properties": {
          "institutionName": {
            "type": "string",
            "description": "institution name of the bank",
            "example": "Stanbic IBTC Bank"
          },
          "page": {
            "type": "integer",
            "description": "page number for response payload",
            "example": 1
          },
          "size": {
            "type": "integer",
            "description": "size of the response object",
            "example": 50
          },
          "institutionCode": {
            "type": "string",
            "description": "6 digit bank code",
            "example": "999221"
          },
          "v1InstitutionCode": {
            "type": "string",
            "description": "3 digit bank code",
            "example": "221"
          },
          "category": {
            "type": "string",
            "description": "category of bank",
            "example": "2"
          },
          "v1InstitutionShortName": {
            "type": "string",
            "description": "short name of bank",
            "example": "STANBIC"
          }
        },
        "example": {
          "institutionName": "Stanbic IBTC Bank",
          "page": 1,
          "size": 50,
          "institutionCode": "999221",
          "v1InstitutionCode": "221",
          "category": "2",
          "v1InstitutionShortName": "STANBIC"
        }
      },
      "bankListSuccessResponseBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "00"
          },
          "message": {
            "type": "string",
            "example": "Successful"
          },
          "data": {
            "type": "object",
            "properties": {
              "totalRecords": {
                "type": "integer",
                "example": 250
              },
              "totalPages": {
                "type": "integer",
                "example": 5
              },
              "content": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "format": "int64",
                      "example": 47
                    },
                    "institutionCode": {
                      "type": "string",
                      "maxLength": 6,
                      "minLength": 6,
                      "example": "999221"
                    },
                    "institutionName": {
                      "type": "string",
                      "example": "Stanbic IBTC Bank"
                    },
                    "v1InstitutionCode": {
                      "type": "string",
                      "example": "221"
                    },
                    "category": {
                      "type": "string",
                      "example": "2"
                    },
                    "v1InstitutionShortName": {
                      "type": "string",
                      "example": "STANBIC"
                    }
                  }
                }
              },
              "number": {
                "type": "integer",
                "example": 0
              },
              "size": {
                "type": "integer",
                "example": 50
              }
            }
          },
          "errors": {
            "type": "string",
            "nullable": true,
            "example": null
          }
        }
      },
      "serviceUnavailableResponseBody": {
        "type": "object",
        "properties": {
          "responsecode": {
            "type": "string",
            "example": "55"
          },
          "responseMsg": {
            "type": "string",
            "example": "Service Currently Unavailable"
          }
        }
      },
      "unauthorizedResponseBody": {
        "type": "object",
        "properties": {
          "httpCode": {
            "type": "string",
            "example": "401"
          },
          "httpMessage": {
            "type": "string",
            "example": "Unauthorized"
          },
          "moreInformation": {
            "type": "string",
            "example": "Invalid client id or secret"
          }
        }
      }
    },
    "securitySchemes": {
      "ClientID": {
        "type": "apiKey",
        "x-key-type": "client_id",
        "name": "Client-Id",
        "in": "header",
        "description": "API Security"
      },
      "ClientSecret": {
        "type": "apiKey",
        "x-key-type": "client_secret",
        "name": "Client-Secret",
        "in": "header",
        "description": "API Security"
      }
    }
  },
  "tags": [
    {
      "name": "REST",
      "description": "This is a RESTful API"
    },
    {
      "name": "Public",
      "description": "No sensitive information, freely accessible metadata"
    },
    {
      "name": "Product Data",
      "description": "Provides catalog-style data such as available banks and their details"
    },
    {
      "name": "System Data",
      "description": "Supplies reference information like bank codes for integration"
    },
    {
      "name": "Stable",
      "description": "Production-ready API"
    }
  ],
  "x-ibm-endpoints": [

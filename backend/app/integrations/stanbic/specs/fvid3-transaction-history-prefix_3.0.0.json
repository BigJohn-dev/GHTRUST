    "paths": {
        "/history": {
            "get": {
                "description": "This API gets the history of transaction done from other banks",
                "parameters": [
                    {
                        "name": "prefixId",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "example": "5050"
                        },
                        "description": "A 4 digit prefix id number"
                    },
                    {
                        "name": "startDate",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "example": "21-MAY-23"
                        },
                        "description": "21-MAY-23"
                    },
                    {
                        "name": "endDate",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "example": "21-MAY-23"
                        },
                        "description": "21-MAY-23"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "example": 1
                        },
                        "description": "page number of response"
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "example": 50
                        },
                        "description": "size of the response object"
                    },
                    {
                        "name": "sessionId",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "The session Id of the transaction"
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/00"
                    },
                    "400": {
                        "$ref": "#/components/responses/99"
                    },
                    "401": {
                        "$ref": "#/components/responses/41"
                    },
                    "500": {
                        "$ref": "#/components/responses/55"
                    }
                }
            },
            "description": "This API gets the history of transaction done from other banks",
            "summary": "This API gets the history of transaction done from other banks"
        },
        "/stanbic-to-stanbic": {
            "get": {
                "description": "This API gets the history of transaction done from StanbicIBTC bank accounts.",
                "parameters": [
                    {
                        "name": "prefixId",
                        "required": true,
                        "in": "query",
                        "schema": {

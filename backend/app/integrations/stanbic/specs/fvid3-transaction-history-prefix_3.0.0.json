                            "type": "string",
                            "example": "21-MAR-23"
                        },
                        "description": "21-MAR-23"
                    },
                    {
                        "name": "endDate",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "example": "21-MAR-23"
                        },
                        "description": "21-MAR-23"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "example": 1
                        },
                        "description": "page number of response"
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "example": 50
                        },
                        "description": "size of the response object"
                    },
                    {
                        "name": "sessionId",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "The session Id of the transaction"
                    }
                ],
                "responses": {
                    "200": {

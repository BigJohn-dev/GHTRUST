    "paths": {
        "/history": {
            "get": {
                "summary": "This API fetches transaction history using a specified virtual account and time range.",
                "description": "This API fetches transaction history using a specified virtual account and time range.",
                "parameters": [
                    {
                        "name": "virtualAccount",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "A virtual account number"
                    },
                    {
                        "name": "startDate",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "example": "21-MAR-23"
                        },
                        "description": "21-MAR-23"
                    },
                    {
                        "name": "endDate",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "example": "21-MAR-23"
                        },
                        "description": "21-MAR-23"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "example": 1
                        },
                        "description": "page number of response"
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "example": 50
                        },
                        "description": "size of the response object"
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/00"
                    },
                    "400": {
                        "$ref": "#/components/responses/99"
                    },
                    "401": {
                        "$ref": "#/components/responses/41"
                    },
                    "500": {
                        "$ref": "#/components/responses/55"
                    }
                }
            },
            "description": "This API fetches transaction history using a specified virtual account and time range.",
            "summary": "This API fetches transaction history using a specified virtual account and time range."
        },
        "/stanbic-to-stanbic": {
            "get": {
                "description": "This API gets the history of transaction done from StanbicIBTC bank accounts.",
                "parameters": [
                    {
                        "name": "virtualAccount",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "A virtual account number"
                    },
                    {
                        "name": "startDate",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "example": "21-MAR-23"
                        },
                        "description": "21-MAR-23"
                    },
                    {
                        "name": "endDate",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "example": "21-MAR-23"
                        },
                        "description": "21-MAR-23"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "example": 1
                        },
                        "description": "page number of response"
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "example": 50
                        },
                        "description": "size of the response object"
                    },
                    {
                        "name": "sessionId",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "example": "94714127491284166"
                        },
                        "description": "The session Id of the transaction"
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/00"
                    },
                    "400": {
                        "$ref": "#/components/responses/99"
                    },
                    "401": {
                        "$ref": "#/components/responses/41"
                    },
                    "500": {
                        "$ref": "#/components/responses/55"
                    }
                }
            },
            "description": "This API gets the history of transaction done from StanbicIBTC bank accounts.",
            "summary": "This API gets the history of transaction done from StanbicIBTC bank accounts."
        }
    },

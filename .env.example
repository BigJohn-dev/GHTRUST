# Next.js staff portal (/admin) — URL of the FastAPI backend.
# The backend must list this site in CORS_ORIGINS (default includes http://localhost:3000).
NEXT_PUBLIC_API_URL=http://localhost:8000
# The portal keeps its refresh token in an httpOnly cookie set by the API, so in
# production the two must share a site (e.g. portal.ghtrust.com + api.ghtrust.com)
# and use HTTPS.

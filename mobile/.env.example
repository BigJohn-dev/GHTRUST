# Public build-time settings for the app. Every EXPO_PUBLIC_* value is compiled into
# the app bundle and readable by anyone who has the app: never put API keys or secrets
# here. Provider credentials (Dojah, Stanbic, Monnify, Termii) live on the backend only.
#
# Local development needs none of these: the app finds the API on the machine running
# Metro. For EAS builds, set them per environment instead of committing a file:
#   npx eas-cli@latest env:create --environment production --name EXPO_PUBLIC_API_URL --value https://api.example.com --visibility plaintext
# To point a local run at a remote API, copy this file to .env.local (git-ignored).

# API origin, without /api/v1. Required for preview and production builds; https for production.
EXPO_PUBLIC_API_URL=

# Store listings, shown on the "update required" screen. Set once the app is published.
EXPO_PUBLIC_IOS_STORE_URL=
EXPO_PUBLIC_ANDROID_STORE_URL=
